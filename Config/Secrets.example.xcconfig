// Copy this file to Secrets.xcconfig (same folder) and fill in your project's
// values from Supabase → Project Settings → API. Secrets.xcconfig is git-ignored.
//
// Use the host only, without https:// — xcconfig files treat // as a comment.
SUPABASE_HOST = your-project-ref.supabase.co

// The "anon" / publishable key. It is safe to ship inside the app: row level
// security in supabase/migrations is what protects the data. Never put the
// service_role / secret key here.
SUPABASE_ANON_KEY = your-anon-key
